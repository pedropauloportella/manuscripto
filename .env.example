# API Configuration
PROJECT_NAME=Manuscripto
SECRET_KEY=substitua_por_uma_chave_aleatoria_e_segura
# IMPORTANTE: O Host do Pooler (porta 6543) é DIFERENTE do host da Direct Connection (porta 5432).
# Obtenha o host correto em Supabase Dashboard > Settings > Database > Connection String > Pooler.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST_DO_POOLER]:6543/postgres?sslmode=require

# OAuth Credentials
ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
ORCID_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment Provider (MercadoPago)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxx-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Storage (Supabase Storage via S3 API)
S3_ENDPOINT=https://[REF].supabase.co/storage/v1/s3
S3_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_BUCKET=manuscripto
S3_REGION=sa-east-1