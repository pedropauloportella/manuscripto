# .env.example
# This file contains example environment variables for the manuscripto project.
# Copy this file to .env and fill in the actual values.

# --- Application Settings ---
APP_NAME=editora
JWT_SECRET=uma_chave_secreta_de_teste # IMPORTANT: Change this to a strong, random secret in production!

# --- Database Settings (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/editora

# --- Redis Settings ---
REDIS_URL=redis://redis:6379/0

# --- S3 Compatible Storage (MinIO for dev) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
S3_BUCKET=editora-bucket

# --- Payment Gateway (MercadoPago Sandbox) ---
MERCADOPAGO_ACCESS_TOKEN=MP_SANDBOX_TOKEN # Get this from your MercadoPago sandbox account

# --- OAuth2 Providers ---
# ORCID
ORCID_CLIENT_ID=ORCID_CLIENT_ID_PLACEHOLDER # Register your app at developer.orcid.org
ORCID_CLIENT_SECRET=ORCID_CLIENT_SECRET_PLACEHOLDER # Keep this secret!
ORCID_REDIRECT_URI=http://localhost:8000/api/auth/orcid/callback # Must match the one registered with ORCID

# Google (Basic/Placeholder)
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
